    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nome" type="String" array="False" size=""/>
            <output expression="&quot;Introduza o seu nome: &quot;" newline="True"/>
            <input variable="nome"/>
            <if expression="nome == &quot;M&#225;rio&quot; Or nome == &quot;Jo&#227;o&quot;">
