        <attribute name="saved" value="2026-08-04 12:36:47 "/>
        <attribute name="created" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDgtMDQ7IjEyOjA4OjM2ICI7MjYwNw=="/>
        <attribute name="edited" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDgtMDQ7IjEyOjM2OjQ3ICI7MTsyNzE4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="preco, desconto, valor" type="Real" array="False" size=""/>
            <declare name="unidades" type="Integer" array="False" size=""/>
            <output expression="&quot;Pre&#231;o unit&#225;rio: &quot;" newline="True"/>
            <input variable="preco"/>
            <output expression="&quot;N&#250;mero de unidades: &quot;" newline="True"/>
            <input variable="unidades"/>
            <output expression="&quot;Desconto (ex: 0.10 para 10%): &quot;" newline="True"/>
            <input variable="desconto"/>
            <assign variable="valor" expression="preco * unidades * (1 - desconto)"/>
            <output expression="&quot;Valor da oportunidade: &quot; &amp; valor" newline="True"/>
        </body>
    </function>
</flowgorithm>
