    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="orcamento" type="Real" array="False" size=""/>
            <output expression="&quot;Or&#231;amento do Lead: &quot;" newline="True"/>
            <input variable="orcamento"/>
            <if expression="orcamento &gt;= 1000">
                <then>
                    <output expression="&quot;Seguir&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Rever&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
