<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1.1_iva"/>
        <attribute name="authors" value="mario"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 02:29:58 "/>
        <attribute name="created" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDgtMTA7IjAyOjIxOjEwICI7MjU5MA=="/>
        <attribute name="edited" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDgtMTA7IjAyOjI5OjU4ICI7MTsyNzE4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="venda, iva, total" type="Real" array="False" size=""/>
            <output expression="&quot;Valor da venda (sem IVA): &quot;" newline="True"/>
            <input variable="venda"/>
            <assign variable="iva" expression="venda * 0.23"/>
            <assign variable="total" expression="venda + iva"/>
            <output expression="&quot;IVA: &quot; &amp; iva" newline="True"/>
            <output expression="&quot;Total a pagar: &quot; &amp; total" newline="True"/>
        </body>
    </function>
</flowgorithm>
