    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="segundos, minutos, resto" type="Integer" array="False" size=""/>
            <output expression="&quot;N&#250;mero de segundos: &quot;" newline="True"/>
            <input variable="segundos"/>
            <assign variable="minutos" expression="segundos / 60"/>
            <assign variable="resto" expression="segundos % 60"/>
            <output expression="minutos &amp; &quot;min e &quot; &amp; resto &amp; &quot;seg&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
