    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
<declare name="dolares, taxa, euros" type="Real" array="False" size=""/>
<output expression="&quot;Valor em dólares: &quot;" newline="True"/>
<input variable="dolares"/>
<output expression="&quot;Taxa de câmbio (ex.: 0.92): &quot;" newline="True"/>
<input variable="taxa"/>
<assign variable="euros" expression="dolares * taxa"/>
<output expression="&quot;Valor em euros: &quot; &amp; euros" newline="True"/>
        </body>
    </function>
</flowgorithm>
