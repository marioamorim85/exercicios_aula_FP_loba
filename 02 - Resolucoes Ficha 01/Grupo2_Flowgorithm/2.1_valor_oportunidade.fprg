<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="valor_oportunidade"/>
        <attribute name="authors" value="mario"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-03 10:00:00 "/>
        <attribute name="created" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDMtMTQ7IjA0OjEzOjU1ICI7MjYwMQ=="/>
        <attribute name="edited" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDMtMTQ7IjA0OjQ1OjE2ICI7MTsyNzEx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
<declare name="preco, unidades, desconto, valor" type="Real" array="False" size=""/>
<output expression="&quot;Preço unitário: &quot;" newline="True"/>
<input variable="preco"/>
<output expression="&quot;Número de unidades: &quot;" newline="True"/>
<input variable="unidades"/>
<output expression="&quot;Desconto (ex.: 0.10 para 10%): &quot;" newline="True"/>
<input variable="desconto"/>
<assign variable="valor" expression="preco * unidades * (1 - desconto)"/>
<output expression="&quot;Valor da oportunidade: &quot; &amp; valor" newline="True"/>
        </body>
    </function>
</flowgorithm>
