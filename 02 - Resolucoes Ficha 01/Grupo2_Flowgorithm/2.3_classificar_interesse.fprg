<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="classificar_interesse"/>
        <attribute name="authors" value="mario"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-03 10:00:00 "/>
        <attribute name="created" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDMtMTQ7IjA0OjEzOjU1ICI7MjYwMQ=="/>
        <attribute name="edited" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDMtMTQ7IjA0OjQ1OjE2ICI7MTsyNzEx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
<declare name="pontuacao" type="Integer" array="False" size=""/>
<declare name="classificacao" type="String" array="False" size=""/>
<output expression="&quot;Pontuação de interesse (0-100): &quot;" newline="True"/>
<input variable="pontuacao"/>
<if expression="pontuacao &gt;= 70">
<then>
<assign variable="classificacao" expression="&quot;Interesse Alto&quot;"/>
</then>
<else>
<if expression="pontuacao &gt;= 40">
<then>
<assign variable="classificacao" expression="&quot;Interesse Médio&quot;"/>
</then>
<else>
<assign variable="classificacao" expression="&quot;Interesse Baixo&quot;"/>
</else>
</if>
</else>
</if>
<output expression="classificacao" newline="True"/>
        </body>
    </function>
</flowgorithm>
