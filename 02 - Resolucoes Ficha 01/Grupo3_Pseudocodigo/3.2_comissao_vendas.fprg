<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="comissao_vendas"/>
        <attribute name="authors" value="mario"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-03 10:00:00 "/>
        <attribute name="created" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDMtMTQ7IjA0OjEzOjU1ICI7MjYwMQ=="/>
        <attribute name="edited" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDMtMTQ7IjA0OjQ1OjE2ICI7MTsyNzEx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
<declare name="venda, comissao" type="Real" array="False" size=""/>
<output expression="&quot;Valor da venda: &quot;" newline="True"/>
<input variable="venda"/>
<if expression="venda &gt; 5000">
<then>
<assign variable="comissao" expression="venda * 0.15"/>
</then>
<else>
<assign variable="comissao" expression="venda * 0.10"/>
</else>
</if>
<output expression="&quot;Comissão: &quot; &amp; comissao" newline="True"/>
        </body>
    </function>
</flowgorithm>
