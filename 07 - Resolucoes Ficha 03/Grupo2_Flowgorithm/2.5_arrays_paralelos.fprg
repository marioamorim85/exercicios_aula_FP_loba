<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="arrays_paralelos"/>
        <attribute name="authors" value="mario"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-18 10:00:00 "/>
        <attribute name="created" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDMtMTQ7IjA0OjEzOjU1ICI7MjYwMQ=="/>
        <attribute name="edited" value="bWFyaW87TUFSSU8tQU1PUklNOzIwMjYtMDMtMTQ7IjA0OjQ1OjE2ICI7MTsyNzEx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
<declare name="nomes" type="String" array="True" size="5"/>
<declare name="orcamentos" type="Real" array="True" size="5"/>
<declare name="i" type="Integer" array="False" size=""/>
<for variable="i" start="0" end="4" direction="inc" step="1">
<output expression="&quot;Nome do lead &quot; &amp; (i + 1) &amp; &quot;: &quot;" newline="True"/>
<input variable="nomes[i]"/>
<output expression="&quot;Orçamento: &quot;" newline="True"/>
<input variable="orcamentos[i]"/>
</for>
<output expression="&quot;--- Lista de leads ---&quot;" newline="True"/>
<for variable="i" start="0" end="4" direction="inc" step="1">
<output expression="nomes[i] &amp; &quot; - &quot; &amp; orcamentos[i]" newline="True"/>
</for>
        </body>
    </function>
</flowgorithm>
